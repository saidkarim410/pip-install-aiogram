{
  "format_version": "1.21.10",
  "minecraft:block": {
    "description": {
      "identifier": "mech:cogwheel",
      "menu_category": {
        "category": "items"
      },
      "states": {
        "mech:spin": [
          false,
          true
        ]
      },
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": [
            "minecraft:block_face"
          ]
        }
      }
    },
    "components": {
      "minecraft:geometry": "geometry.mech_cogwheel",
      "minecraft:material_instances": {
        "*": {
          "texture": "mech_cog",
          "render_method": "alpha_test",
          "ambient_occlusion": false,
          "face_dimming": true
        },
        "shaft": {
          "texture": "mech_shaft",
          "render_method": "alpha_test",
          "ambient_occlusion": false,
          "face_dimming": true
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.8
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 2
      },
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#777777",
      "minecraft:collision_box": {
        "origin": [
          -8,
          6,
          -8
        ],
        "size": [
          16,
          4,
          16
        ]
      },
      "minecraft:selection_box": {
        "origin": [
          -8,
          0,
          -8
        ],
        "size": [
          16,
          16,
          16
        ]
      },
      "minecraft:custom_components": [
        "mech:kinetic"
      ]
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:block_face') == 'north' || q.block_state('minecraft:block_face') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'east' || q.block_state('minecraft:block_face') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              90
            ]
          }
        }
      },
      {
        "condition": "q.block_state('mech:spin')",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "mech_cog_spin",
              "render_method": "alpha_test",
              "ambient_occlusion": false,
              "face_dimming": true
            },
            "shaft": {
              "texture": "mech_shaft_spin",
              "render_method": "alpha_test",
              "ambient_occlusion": false,
              "face_dimming": true
            }
          }
        }
      }
    ]
  }
}
